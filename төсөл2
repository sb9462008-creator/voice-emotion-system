def record_audio(duration=None, sr=None):
    """
    Микрофоноор дуу бичих функц
    
    Parameters:
        duration: Бичлэгийн урт (секунд). None бол CONFIG-аас авна
        sr: Sampling rate. None бол CONFIG-аас авна
        
    Returns:
        recording: Numpy array хэлбэрийн дуу бичлэг
    """
    # Хэрэв утга өгөөгүй бол CONFIG-аас авах
    if duration is None:
        duration = CONFIG['duration']
    if sr is None:
        sr = CONFIG['sr']
    
    # Хэрэглэгчид мэдээлэл өгөх
    print(f"\n {duration} секундын дуу бичиж байна...")
    print("   Та одоо ярина уу!")
    
    # Микрофоноор бичих: duration*sr = нийт сэмплийн тоо
    # samplerate=sr: секундэд хэдэн сэмпл авах
    # channels=1: моно дуу (1 суваг)
    # dtype='float32': өгөгдлийн төрөл
    recording = sd.rec(int(duration * sr), samplerate=sr, channels=1, dtype='float32')
    sd.wait()  # Бичлэг дуустал хүлээх
    
    print(" Дуу амжилттай бичигдлээ!\n")
    return np.squeeze(recording)  # 2D массивыг 1D болгох

# 
#  ДЭВШИЛТЭТ ШИНЖ ЧАНАР ГАРГАХ
# 
def extract_advanced_features(audio, sr=None):
    """
    Олон төрлийн шинж чанаруудыг гаргаж авах функц
    
    Гаргаж авах шинж чанарууд:
    1. MFCC - Дууны өнгө, тембрийг илэрхийлнэ
    2. Chroma - Аялгуу, хөгжмийн нот мэдрэх
    3. Mel Spectrogram - Давтамжийн хуваарь
    4. Spectral Contrast - Өндөр ба намхан давтамжийн ялгаа
    5. Tonnetz - Гармоник бүтэц, аялгуу холбоо
    6. Zero Crossing Rate - Дохио тэг огтлох хурд (дууны ширүүн байдал)
    7. Spectral Centroid - Давтамжийн төв (дууны "тод байдал")
    8. Spectral Rolloff - Давтамжийн хязгаар
    9. RMS Energy - Дуу чимээний эрчим хүч
    
    Parameters:
        audio: Дуу хоолойн numpy array
        sr: Sampling rate
        
    Returns:
        feature_vector: Бүх шинж чанаруудыг агуулсан вектор (1, n) хэмжээтэй
    """
    if sr is None:
        sr = CONFIG['sr']
    
    # Чимээгүй хэсгийг арилгах (дууны эхэн төгсгөлийн чимээгүй хэсэг)
    # top_db=25: 25 децибелээс чимээгүй хэсгийг арилгах
    audio, _ = librosa.effects.trim(audio, top_db=25)
    
    features = []  # Бүх шинж чанаруудыг энд цуглуулна
    
    try:
        #  1. MFCC болон түүний туурвалууд 
        # MFCC: Дууны онцлог тембр, өнгийг илэрхийлнэ
        mfcc = librosa.feature.mfcc(y=audio, sr=sr, n_mfcc=CONFIG['n_mfcc'])
        
        # Delta (1-р зэрэглэлийн туурвал): MFCC-ийн өөрчлөлтийн хурд
        mfcc_delta = librosa.feature.delta(mfcc)
        
        # Delta-delta (2-р зэрэглэлийн туурвал): Өөрчлөлтийн үргэлжлэх чиг хандлага
        mfcc_delta2 = librosa.feature.delta(mfcc, order=2)
        
        # Дундаж ба стандарт хазайлтыг авах (цаг хугацааны дундаж)
        features.extend([
            np.mean(mfcc, axis=1),      # MFCC-ийн дундаж
            np.std(mfcc, axis=1),       # MFCC-ийн хазайлт
            np.mean(mfcc_delta, axis=1),    # Өөрчлөлтийн дундаж
            np.mean(mfcc_delta2, axis=1)    # Хурдатгалын дундаж
        ])
        
        # 2. Chroma - Аялгуу, нотны мэдээлэл 
        # 12 хагас аяыг (C, C#, D, ... B) илрүүлнэ
        chroma = librosa.feature.chroma_stft(y=audio, sr=sr)
        features.extend([
            np.mean(chroma, axis=1),  # Аялгууны дундаж
            np.std(chroma, axis=1)    # Аялгууны хазайлт
        ])
        
        #  3. Mel Spectrogram - Давтамжийн задаргаа 
        # Хүний чих адил давтамжийг мэдрэх (бага давтамжид илүү мэдрэг)
        mel = librosa.feature.melspectrogram(y=audio, sr=sr)
        features.extend([
            np.mean(mel, axis=1),  # Mel давтамжийн дундаж
            np.std(mel, axis=1)    # Mel давтамжийн хазайлт
        ])
        
        #  4. Spectral Contrast - Давтамжийн контраст 
        # Өндөр ба намхан давтамжийн хоорондын ялгааг тодорхойлно
        contrast = librosa.feature.spectral_contrast(y=audio, sr=sr)
        features.extend([
            np.mean(contrast, axis=1),  # Контрастын дундаж
            np.std(contrast, axis=1)    # Контрастын хазайлт
        ])
        
        #  5. Tonnetz - Гармоник бүтэц 
        # Аялгуунуудын хоорондын харилцааг илэрхийлнэ
        tonnetz = librosa.feature.tonnetz(y=audio, sr=sr)
        features.extend([
            np.mean(tonnetz, axis=1),  # Гармоникийн дундаж
            np.std(tonnetz, axis=1)    # Гармоникийн хазайлт
        ])
        
        #  6. Zero Crossing Rate - Тэг огтлох хурд 
        # Дохио тэгийг хэдэн удаа огтлох (дууны ширүүн байдлыг илэрхийлнэ)
        zcr = librosa.feature.zero_crossing_rate(audio)
        features.append([np.mean(zcr), np.std(zcr)])
        
        #  7. Spectral Centroid - Давтамжийн төв 
        # Дууны "тод байдал" - Өндөр утга = гэрэл тод дуу
        spectral_centroid = librosa.feature.spectral_centroid(y=audio, sr=sr)
        features.append([np.mean(spectral_centroid), np.std(spectral_centroid)])
        
        #  8. Spectral Rolloff - Давтамжийн хязгаар 
        # Спектрийн эрчим хүчний 85% багтаах доод давтамж
        spectral_rolloff = librosa.feature.spectral_rolloff(y=audio, sr=sr)
        features.append([np.mean(spectral_rolloff), np.std(spectral_rolloff)])
        
        #  9. RMS Energy - Дуу чимээний эрчим 
        # Дууны хүч чадал, чанга байдал
        rms = librosa.feature.rms(y=audio)
        features.append([np.mean(rms), np.std(rms)])
        
        # Бүх шинж чанарыг нэг урт вектор болгох
        # flatten(): хэмжээс нь (n,) болгоно
        # concatenate(): бүх массивуудыг холбоно
        feature_vector = np.concatenate([np.array(f).flatten() for f in features])
        
        # Reshape хийж (1, n) хэмжээтэй болгох (sklearn-д шаардлагатай)
        return feature_vector.reshape(1, -1)
        
    except Exception as e:
        print(f" Шинж чанар гаргахад алдаа гарлаа: {e}")
        return None

